# App -> backend authentication. Generate a long random value and put the same value
# into the Android app's "Токен" field.
AGENT_API_TOKEN=change-me-to-a-long-random-secret
PUBLIC_BASE_URL=https://your-public-domain.example

# OpenAI project used by SIP + Live.
OPENAI_API_KEY=sk-proj-...
OPENAI_PROJECT_ID=proj_...
OPENAI_WEBHOOK_SECRET=whsec_...
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=marin
# Default global SIP edge. For an eligible EU project you can use sip-eu.api.openai.com.
OPENAI_SIP_HOST=sip.api.openai.com

# Twilio Programmable Voice number.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+15551234567
TWILIO_VALIDATE_WEBHOOKS=true

# Voice-agent policy.
AI_OWNER_NAME=Алексей
AI_INBOUND_CALLS_ENABLED=false
# Keep false until you have a lawful recording/consent policy for the places you call.
AI_CALL_RECORDING_ENABLED=false
AI_CALL_MAX_SECONDS=600
AI_CALL_DB=phone_jobs.sqlite3
